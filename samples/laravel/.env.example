CALLIOPEIA_GRAPHQL_URL=https://your-appsync-host.example/graphql
CALLIOPEIA_APPSYNC_API_KEY=replace-with-your-environment-key
CALLIOPEIA_PULL_URL=https://your-result-api.example
CALLIOPEIA_API_KEY=replace-with-your-tenant-api-key

CACHE_STORE=database
QUEUE_CONNECTION=database
CALLIOPEIA_WEBHOOK_ENABLED=true
CALLIOPEIA_WEBHOOK_PATH=api/calliopeia/webhooks
CALLIOPEIA_WEBHOOK_PAYLOAD_PROFILE=SUMMARY_CALLBACK_V1
CALLIOPEIA_WEBHOOK_AUTH_MODE=BEARER
CALLIOPEIA_WEBHOOK_TOKEN=replace-with-a-random-token-of-at-least-32-bytes
CALLIOPEIA_WEBHOOK_QUEUE_CONNECTION=database
CALLIOPEIA_WEBHOOK_QUEUE=calliopeia-webhooks
